{
  "_about": [
    "Shared cases for the mid-stay price change planner. tests/test_rate_segments.py runs them against services/rate_segments.py and tests/test_state_ports.js runs them against window.CibaraRateChange in static/script.js, so the server and the modal preview cannot drift apart unnoticed.",
    "current_night: checkin_time and now are IST wall-clock stamps; expected null means the check-in time is unreadable.",
    "plan: inputs mirror a room document (renewal_count, guest). night is the current night from the clock, or null. Each case has either expected (the plan) or error (the exact refusal message)."
  ],
  "current_night": [
    {"name": "exactly at check-in is night 1",
     "checkin_time": "2026-09-08 14:00", "now": "2026-09-08 14:00", "expected": 1},
    {"name": "one minute short of 24h is still night 1",
     "checkin_time": "2026-09-08 14:00", "now": "2026-09-09 13:59", "expected": 1},
    {"name": "24h after check-in starts night 2",
     "checkin_time": "2026-09-08 14:00", "now": "2026-09-09 14:00", "expected": 2},
    {"name": "crossing midnight does not start a night",
     "checkin_time": "2026-09-08 22:00", "now": "2026-09-09 09:00", "expected": 1},
    {"name": "third 24h cycle is night 3",
     "checkin_time": "2026-09-08 14:00", "now": "2026-09-10 20:00", "expected": 3},
    {"name": "cycles run across a month end",
     "checkin_time": "2026-08-30 11:30", "now": "2026-09-02 11:30", "expected": 4},
    {"name": "seconds on the check-in stamp are ignored",
     "checkin_time": "2026-09-08 14:00:45", "now": "2026-09-09 14:00", "expected": 2},
    {"name": "a clock behind the check-in clamps to night 1",
     "checkin_time": "2026-09-08 14:00", "now": "2026-09-08 10:00", "expected": 1},
    {"name": "an empty check-in time is unreadable",
     "checkin_time": "", "now": "2026-09-09 14:00", "expected": null},
    {"name": "a missing check-in time is unreadable",
     "checkin_time": null, "now": "2026-09-09 14:00", "expected": null},
    {"name": "a malformed check-in time is unreadable",
     "checkin_time": "09/08/2026 2pm", "now": "2026-09-09 14:00", "expected": null},
    {"name": "an impossible calendar date is unreadable",
     "checkin_time": "2026-02-30 10:00", "now": "2026-03-05 10:00", "expected": null}
  ],
  "plan": [
    {"name": "today on night 2 re-prices tonight",
     "room": "213", "renewal_count": 1,
     "guest": {"price": 400, "transfer_day_offset": 0, "pre_transfer_charges": []},
     "new_price": 600, "effective": "today", "night": 2,
     "expected": {"boundary": 1, "first_new_night": 2, "nights_repriced": 1, "balance_delta": 200,
                  "segments": [{"days": 1, "price": 400, "total": 400, "from_room": "213", "kind": "rate_change"}],
                  "offset": 1}},

    {"name": "tomorrow on night 2 leaves the balance alone",
     "room": "213", "renewal_count": 1,
     "guest": {"price": 400, "transfer_day_offset": 0, "pre_transfer_charges": []},
     "new_price": 600, "effective": "tomorrow", "night": 2,
     "expected": {"boundary": 2, "first_new_night": 3, "nights_repriced": 0, "balance_delta": 0,
                  "segments": [{"days": 2, "price": 400, "total": 800, "from_room": "213", "kind": "rate_change"}],
                  "offset": 2}},

    {"name": "today on night 1 re-prices the stay so far and writes no segment",
     "room": "213", "renewal_count": 0,
     "guest": {"price": 400},
     "new_price": 450, "effective": "today", "night": 1,
     "expected": {"boundary": 0, "first_new_night": 1, "nights_repriced": 1, "balance_delta": 50,
                  "segments": [], "offset": 0}},

    {"name": "tomorrow on night 1",
     "room": "213", "renewal_count": 0,
     "guest": {"price": 400},
     "new_price": 450, "effective": "tomorrow", "night": 1,
     "expected": {"boundary": 1, "first_new_night": 2, "nights_repriced": 0, "balance_delta": 0,
                  "segments": [{"days": 1, "price": 400, "total": 400, "from_room": "213", "kind": "rate_change"}],
                  "offset": 1}},

    {"name": "a price cut lowers the balance",
     "room": "213", "renewal_count": 2,
     "guest": {"price": 800, "transfer_day_offset": 0, "pre_transfer_charges": []},
     "new_price": 700, "effective": "today", "night": 3,
     "expected": {"boundary": 2, "first_new_night": 3, "nights_repriced": 1, "balance_delta": -100,
                  "segments": [{"days": 2, "price": 800, "total": 1600, "from_room": "213", "kind": "rate_change"}],
                  "offset": 2}},

    {"name": "tonight not renewed yet: today is allowed and the renewal will charge the new price",
     "room": "213", "renewal_count": 1,
     "guest": {"price": 400, "transfer_day_offset": 0, "pre_transfer_charges": []},
     "new_price": 600, "effective": "today", "night": 3,
     "expected": {"boundary": 2, "first_new_night": 3, "nights_repriced": 0, "balance_delta": 0,
                  "segments": [{"days": 2, "price": 400, "total": 800, "from_room": "213", "kind": "rate_change"}],
                  "offset": 2}},

    {"name": "tonight not renewed yet: tomorrow is refused",
     "room": "213", "renewal_count": 1,
     "guest": {"price": 400, "transfer_day_offset": 0, "pre_transfer_charges": []},
     "new_price": 600, "effective": "tomorrow", "night": 3,
     "error": "Tonight's rent (night 3) has not been renewed yet. Renew it first, then set the new price from tomorrow."},

    {"name": "two nights not renewed: today is refused",
     "room": "213", "renewal_count": 0,
     "guest": {"price": 400},
     "new_price": 600, "effective": "today", "night": 3,
     "error": "Rent has been charged up to night 1, but the stay is on night 3. Renew the pending rent first, then set the new price."},

    {"name": "two nights not renewed: tomorrow is refused",
     "room": "213", "renewal_count": 0,
     "guest": {"price": 400},
     "new_price": 600, "effective": "tomorrow", "night": 3,
     "error": "Rent has been charged up to night 1, but the stay is on night 3. Renew the pending rent first, then set the new price."},

    {"name": "tomorrow then today on the same night reopens tonight at the same price",
     "room": "213", "renewal_count": 1,
     "guest": {"price": 600, "transfer_day_offset": 2,
               "pre_transfer_charges": [{"days": 2, "price": 400, "total": 800, "from_room": "213", "kind": "rate_change"}]},
     "new_price": 600, "effective": "today", "night": 2,
     "expected": {"boundary": 1, "first_new_night": 2, "nights_repriced": 1, "balance_delta": 200,
                  "segments": [{"days": 1, "price": 400, "total": 400, "from_room": "213", "kind": "rate_change"}],
                  "offset": 1}},

    {"name": "tomorrow then today at a different price re-prices tonight from its frozen rate",
     "room": "213", "renewal_count": 1,
     "guest": {"price": 600, "transfer_day_offset": 2,
               "pre_transfer_charges": [{"days": 2, "price": 400, "total": 800, "from_room": "213", "kind": "rate_change"}]},
     "new_price": 650, "effective": "today", "night": 2,
     "expected": {"boundary": 1, "first_new_night": 2, "nights_repriced": 1, "balance_delta": 250,
                  "segments": [{"days": 1, "price": 400, "total": 400, "from_room": "213", "kind": "rate_change"}],
                  "offset": 1}},

    {"name": "reopening a one-night segment removes it",
     "room": "213", "renewal_count": 2,
     "guest": {"price": 600, "transfer_day_offset": 3,
               "pre_transfer_charges": [{"days": 2, "price": 400, "total": 800, "from_room": "213", "kind": "rate_change"},
                                        {"days": 1, "price": 500, "total": 500, "from_room": "213", "kind": "rate_change"}]},
     "new_price": 600, "effective": "today", "night": 3,
     "expected": {"boundary": 2, "first_new_night": 3, "nights_repriced": 1, "balance_delta": 100,
                  "segments": [{"days": 2, "price": 400, "total": 800, "from_room": "213", "kind": "rate_change"}],
                  "offset": 2}},

    {"name": "a later check-in time can reopen two segments",
     "room": "213", "renewal_count": 2,
     "guest": {"price": 600, "transfer_day_offset": 3,
               "pre_transfer_charges": [{"days": 2, "price": 400, "total": 800, "from_room": "213", "kind": "rate_change"},
                                        {"days": 1, "price": 500, "total": 500, "from_room": "213", "kind": "rate_change"}]},
     "new_price": 600, "effective": "today", "night": 2,
     "expected": {"boundary": 1, "first_new_night": 2, "nights_repriced": 2, "balance_delta": 300,
                  "segments": [{"days": 1, "price": 400, "total": 400, "from_room": "213", "kind": "rate_change"}],
                  "offset": 1}},

    {"name": "a zero-night segment is dropped while reopening",
     "room": "213", "renewal_count": 1,
     "guest": {"price": 600, "transfer_day_offset": 2,
               "pre_transfer_charges": [{"days": 2, "price": 400, "total": 800, "from_room": "213", "kind": "rate_change"},
                                        {"days": 0, "price": 900, "total": 0, "from_room": "101"}]},
     "new_price": 600, "effective": "today", "night": 2,
     "expected": {"boundary": 1, "first_new_night": 2, "nights_repriced": 1, "balance_delta": 200,
                  "segments": [{"days": 1, "price": 400, "total": 400, "from_room": "213", "kind": "rate_change"}],
                  "offset": 1}},

    {"name": "a room shift that folded tonight into the old room cannot be reopened",
     "room": "213", "renewal_count": 1,
     "guest": {"price": 500, "transfer_day_offset": 2,
               "pre_transfer_charges": [{"days": 2, "price": 800, "total": 1600, "from_room": "101"}]},
     "new_price": 600, "effective": "today", "night": 2,
     "error": "Night 2 is billed at Room 101's rate from the room shift, so the new price can start from night 3 at the earliest."},

    {"name": "after that room shift, tomorrow works and writes no segment",
     "room": "213", "renewal_count": 1,
     "guest": {"price": 500, "transfer_day_offset": 2,
               "pre_transfer_charges": [{"days": 2, "price": 800, "total": 1600, "from_room": "101"}]},
     "new_price": 600, "effective": "tomorrow", "night": 2,
     "expected": {"boundary": 2, "first_new_night": 3, "nights_repriced": 0, "balance_delta": 0,
                  "segments": [{"days": 2, "price": 800, "total": 1600, "from_room": "101"}],
                  "offset": 2}},

    {"name": "reopening stops at a room shift behind an earlier change",
     "room": "213", "renewal_count": 2,
     "guest": {"price": 600, "transfer_day_offset": 3,
               "pre_transfer_charges": [{"days": 2, "price": 800, "total": 1600, "from_room": "101"},
                                        {"days": 1, "price": 500, "total": 500, "from_room": "213", "kind": "rate_change"}]},
     "new_price": 600, "effective": "today", "night": 2,
     "error": "Night 2 is billed at Room 101's rate from the room shift, so the new price can start from night 3 at the earliest."},

    {"name": "after a room shift on an earlier day the change freezes the current room's nights",
     "room": "213", "renewal_count": 2,
     "guest": {"price": 500, "transfer_day_offset": 1, "last_transfer_date": "2026-09-09",
               "pre_transfer_charges": [{"days": 1, "price": 800, "total": 800, "from_room": "101"}]},
     "new_price": 600, "effective": "today", "night": 3,
     "expected": {"boundary": 2, "first_new_night": 3, "nights_repriced": 1, "balance_delta": 100,
                  "segments": [{"days": 1, "price": 800, "total": 800, "from_room": "101"},
                               {"days": 1, "price": 500, "total": 500, "from_room": "213", "kind": "rate_change"}],
                  "offset": 2}},

    {"name": "after an add-on raised the rate on an earlier day",
     "room": "213", "renewal_count": 2,
     "guest": {"price": 600, "transfer_day_offset": 2,
               "pre_transfer_charges": [{"days": 2, "price": 400, "total": 800, "from_room": "213"}]},
     "new_price": 650, "effective": "today", "night": 3,
     "expected": {"boundary": 2, "first_new_night": 3, "nights_repriced": 1, "balance_delta": 50,
                  "segments": [{"days": 2, "price": 400, "total": 800, "from_room": "213"}],
                  "offset": 2}},

    {"name": "an add-on that raised the rate tonight cannot be reopened",
     "room": "213", "renewal_count": 1,
     "guest": {"price": 600, "transfer_day_offset": 2,
               "pre_transfer_charges": [{"days": 2, "price": 400, "total": 800, "from_room": "213"}]},
     "new_price": 650, "effective": "today", "night": 2,
     "error": "Night 2 was re-rated when an add-on raised the nightly price, so the new price can start from night 3 at the earliest."},

    {"name": "an add-on that raised the rate tonight: tomorrow works",
     "room": "213", "renewal_count": 1,
     "guest": {"price": 600, "transfer_day_offset": 2,
               "pre_transfer_charges": [{"days": 2, "price": 400, "total": 800, "from_room": "213"}]},
     "new_price": 650, "effective": "tomorrow", "night": 2,
     "expected": {"boundary": 2, "first_new_night": 3, "nights_repriced": 0, "balance_delta": 0,
                  "segments": [{"days": 2, "price": 400, "total": 800, "from_room": "213"}],
                  "offset": 2}},

    {"name": "the same price is refused when nothing would change",
     "room": "213", "renewal_count": 1,
     "guest": {"price": 400},
     "new_price": 400, "effective": "today", "night": 2,
     "error": "That is already the current price."},

    {"name": "an unreadable check-in time falls back to the nights charged",
     "room": "213", "renewal_count": 2,
     "guest": {"price": 400},
     "new_price": 600, "effective": "today", "night": null,
     "expected": {"boundary": 2, "first_new_night": 3, "nights_repriced": 1, "balance_delta": 200,
                  "segments": [{"days": 2, "price": 400, "total": 800, "from_room": "213", "kind": "rate_change"}],
                  "offset": 2}},

    {"name": "segments that do not add up to the offset are refused",
     "room": "213", "renewal_count": 2,
     "guest": {"price": 600, "transfer_day_offset": 2,
               "pre_transfer_charges": [{"days": 1, "price": 400, "total": 400, "from_room": "213"}]},
     "new_price": 650, "effective": "today", "night": 3,
     "error": "This stay's earlier price changes do not add up, so the new price cannot be placed safely. Correct the tariff from the bill's Edit Price after checkout."},

    {"name": "an offset with no segments is refused",
     "room": "213", "renewal_count": 2,
     "guest": {"price": 600, "transfer_day_offset": 1},
     "new_price": 650, "effective": "tomorrow", "night": 3,
     "error": "This stay's earlier price changes do not add up, so the new price cannot be placed safely. Correct the tariff from the bill's Edit Price after checkout."},

    {"name": "earlier segments covering more nights than charged are refused",
     "room": "213", "renewal_count": 0,
     "guest": {"price": 500, "transfer_day_offset": 2,
               "pre_transfer_charges": [{"days": 2, "price": 800, "total": 1600, "from_room": "101"}]},
     "new_price": 600, "effective": "today", "night": 1,
     "error": "Earlier price changes cover 2 nights, but rent has been charged for only 1. Renew the pending rent first, then set the new price."}
  ]
}
